# IDE/agent tooling, not project files. These stay in the repo root because each tool only
# looks for its project-level config there: .claude/ (settings.local.json holds the
# no-AI-attribution commit rule and permissions), .agents/ + skills-lock.json (written
# together by the skills CLI; .claude/skills/typesafe-ai is a junction into .agents/),
# .qodo/ (Qodo/Codium extension), .vscode/ (workspace settings, listed under Editors below).
.agents/
.claude/
.qodo/
skills-lock.json
# Local tool binaries do not belong in the working tree; keep them under ~/.local/bin.
claude.exe

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Streamlit
.streamlit/secrets.toml

# Cached Exa search results (local dev provider)
backend/data/exa_cache/

# Generated Word summaries for Edwin/Liz
backend/data/summaries/

# SQLite
*.db
*.db-journal
*.sqlite
*.sqlite3

# Playwright
playwright-report/
test-results/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

screenshots/