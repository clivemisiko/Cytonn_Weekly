# Copy to .env (gitignored) in the repo root and fill in what you need. Never commit real values.
# Native runs: entrypoints (backend/scripts/, the review API) load .env via
# cytonn_weekly.env.load_env(); a variable already set in the shell wins over .env. Library
# code only reads os.environ. Docker: docker-compose.yml passes this file to the api
# container with env_file.

# --- Drafting (every section's highlights / narrative) ---------------------------------------

# Anthropic API key, read by the Anthropic SDK itself. Required whenever CYTONN_LLM_PROVIDER is
# anthropic (the default), i.e. for any production draft. Spends API budget.
ANTHROPIC_API_KEY=
# Optional. An Anthropic auth token, accepted in place of ANTHROPIC_API_KEY (read by the SDK;
# the API's missing-key check accepts either).
ANTHROPIC_AUTH_TOKEN=
# Optional. "anthropic" (default when unset) or "local" (Ollama + Exa, DEV MODE: never publish or send).
CYTONN_LLM_PROVIDER=
# Optional, local mode only. Ollama model to draft with; default phi4-mini.
CYTONN_LOCAL_MODEL=
# Optional, local mode only. Where Ollama listens; default http://localhost:11434.
# docker-compose.yml sets it to http://host.docker.internal:11434 for the container
# (Ollama runs on the host), and that setting wins over this file.
CYTONN_OLLAMA_URL=
# Optional, local mode only. 1/true/yes ignores the cached Exa results in backend/data/exa_cache/ and re-queries Exa.
CYTONN_EXA_REFRESH=
# Exa search API key. Required for local mode (unless every search is already cached) and for
# backend/scripts/check_exa_ir_sourcing.py; not used by the production (anthropic) path.
EXA_API_KEY=

# --- Word summary email to Edwin and Liz (backend/scripts/send_weekly_summary.py) ----------------

# Required to send. SMTP server hostname.
CYTONN_SMTP_HOST=
# Optional. SMTP port; default 587 (STARTTLS).
CYTONN_SMTP_PORT=
# Optional. SMTP login name; if unset, no login is attempted.
CYTONN_SMTP_USER=
# Required when CYTONN_SMTP_USER is set. SMTP password.
CYTONN_SMTP_PASSWORD=
# Optional. Sender address; falls back to CYTONN_SMTP_USER (one of the two is required to send).
CYTONN_SMTP_FROM=
# Required to send. Comma-separated recipient addresses for the Word summary.
CYTONN_SUMMARY_RECIPIENTS=

# --- Review API (backend/api/main.py) -----------------------------------------------------------

# Optional. Comma-separated browser origins allowed by CORS; default
# http://localhost:3000,http://127.0.0.1:3000. Works from this file or the shell (the shell wins).
# Left commented: set but empty, it would allow no origins at all.
# CYTONN_WEB_ORIGINS=

# --- Data folder --------------------------------------------------------------------------------

# Optional. Folder holding app.db, exa_cache/ and summaries/; default backend/data. It is read
# when the package is imported, before .env is loaded, so for a native run set it in the shell,
# not here. docker-compose.yml sets it to /app/data (the cytonn_data volume).
# Left commented: it has no effect from this file on a native run.
# CYTONN_DATA_DIR=

# --- Web app (frontend/) ------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL (optional, default http://127.0.0.1:8000) is not read from this file.
# Native runs: Next.js reads it from frontend/.env.local. Docker: it is a build argument in
# docker-compose.yml. It is the address the browser reaches the API at.
