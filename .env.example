# Copy to .env (gitignored) in the repo root and fill in what you need. Never commit real values.
# Native runs: entrypoints (backend/scripts/, the review API) load .env via
# cytonn_weekly.env.load_env(); a variable already set in the shell wins over .env. Library
# code only reads os.environ. Docker: docker-compose.yml passes this file to the api
# container with env_file.

# --- Drafting (every section's highlights / narrative) ---------------------------------------

# Anthropic API key, read by the Anthropic SDK itself. Required whenever CYTONN_LLM_PROVIDER is
# anthropic (the default), i.e. for any production draft. Spends API budget.
ANTHROPIC_API_KEY=
# Optional. An Anthropic auth token, accepted in place of ANTHROPIC_API_KEY (read by the SDK;
# the API's missing-key check accepts either).
ANTHROPIC_AUTH_TOKEN=
# Optional. "anthropic" (default when unset) or "local" (Ollama + Exa, DEV MODE: never publish or send).
CYTONN_LLM_PROVIDER=
# Optional, local mode only. Ollama model to draft with; default phi4-mini.
CYTONN_LOCAL_MODEL=
# Optional, local mode only. Where Ollama listens; default http://localhost:11434.
# docker-compose.yml sets it to http://host.docker.internal:11434 for the container
# (Ollama runs on the host), and that setting wins over this file.
CYTONN_OLLAMA_URL=
# Optional, local mode only. 1/true/yes ignores the cached Exa results in backend/data/exa_cache/ and re-queries Exa.
CYTONN_EXA_REFRESH=
# Optional, local mode only: speed settings for the local model. Each is commented out; unset,
# empty or blank means the default. A value that is not an integer in the range is ignored with
# one warning and the default is used. The context size (num_ctx) is fixed at 8192 and has no setting.
# How many search results the model is given. Integer 1 to 5; default 5.
# CYTONN_LOCAL_MAX_SEARCH_RESULTS=
# Characters of text kept per search result, cut at a word boundary and never inside a number.
# Integer 500 to 3000; default: no extra cut (results are already at most 3000 characters).
# CYTONN_LOCAL_RESULT_CHARS=
# Ollama num_thread. Integer 1 to 16; default: not sent, so Ollama picks the thread count.
# CYTONN_LOCAL_NUM_THREAD=
# Ollama num_predict, the cap on generated tokens. Integer 1024 to 4096; default 2048.
# CYTONN_LOCAL_NUM_PREDICT=
# Fast dev preset (local model only): CYTONN_LOCAL_MAX_SEARCH_RESULTS=2, CYTONN_LOCAL_RESULT_CHARS=1500, CYTONN_LOCAL_NUM_THREAD=8, CYTONN_LOCAL_NUM_PREDICT=1400
# The preset is for development only, and the measured saving is not yet confirmed for the
# combined preset. It gives the model less to draft from, so drafts differ from the default's.
# Exa search API key. Required for local mode (unless every search is already cached) and for
# backend/scripts/check_exa_ir_sourcing.py; not used by the production (anthropic) path.
EXA_API_KEY=

# --- Word summary email to Edwin and Liz (backend/scripts/send_weekly_summary.py) ----------------

# Required to send. SMTP server hostname.
CYTONN_SMTP_HOST=
# Optional. SMTP port; default 587 (STARTTLS).
CYTONN_SMTP_PORT=
# Optional. SMTP login name; if unset, no login is attempted.
CYTONN_SMTP_USER=
# Required when CYTONN_SMTP_USER is set. SMTP password.
CYTONN_SMTP_PASSWORD=
# Optional. Sender address; falls back to CYTONN_SMTP_USER (one of the two is required to send).
CYTONN_SMTP_FROM=
# Required to send. Comma-separated recipient addresses for the Word summary.
CYTONN_SUMMARY_RECIPIENTS=

# --- Review API (backend/api/main.py) -----------------------------------------------------------

# Optional. Comma-separated browser origins allowed by CORS; default
# http://localhost:5173,http://127.0.0.1:5173. Works from this file or the shell (the shell wins).
# The web app needs none of them as it is run here: its own server proxies /api to this API.
# Left commented: set but empty, it would allow no origins at all.
# CYTONN_WEB_ORIGINS=

# --- Data folder --------------------------------------------------------------------------------

# Optional. Folder holding app.db, exa_cache/ and summaries/; default backend/data. It is read
# when the package is imported, before .env is loaded, so for a native run set it in the shell,
# not here. docker-compose.yml sets it to /app/data (the cytonn_data volume).
# Left commented: it has no effect from this file on a native run.
# CYTONN_DATA_DIR=

# --- Database -----------------------------------------------------------------------------------

# Optional. A PostgreSQL URL (Supabase) makes the app use PostgreSQL instead of backend/data/app.db:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE. Unset (or blank), the SQLite file is used. Use the
# pooler's session mode (port 5432); transaction mode (6543) does not hold the schema setting. SSL is
# always required: sslmode=require is added when the URL has none, and a weaker sslmode is refused.
# A password with special characters must be percent-encoded (an @ in it is %40, an & is %26); a URL
# with a raw @ in the password is refused. The URL is never logged or shown in an error.
# Left commented so the SQLite app keeps working.
# CYTONN_DATABASE_URL=

# Optional. The PostgreSQL schema the tables live in; default cytonn. Never public, which Supabase
# exposes through its web API. Lower-case letters, digits and underscores.
# CYTONN_DATABASE_SCHEMA=

# Optional, tests only. A PostgreSQL URL for backend/tests/test_postgres_smoke.py, which creates a
# throwaway schema in it and drops it afterwards. Unset, that test is skipped. Never the app's schema.
# CYTONN_TEST_DATABASE_URL=

# --- Web app (frontend/) ------------------------------------------------------------------------
# VITE_API_TARGET (optional, default http://127.0.0.1:8000) is not read from this file. It is
# the API the web app's own server proxies /api to. Native runs: set it in the shell before
# `npm run dev`. Docker: docker-compose.yml sets it to the api service.
